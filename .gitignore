# Environment & virtual environments
.env
.env.*
!.env.example
.venv/
venv/
env/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Local user data, vector indexes, uploads, version archives & backups
data/uploads/*
!data/uploads/.gitkeep
data/chroma/*
!data/chroma/.gitkeep
data/sessions/*
!data/sessions/.gitkeep
data/versions/*
!data/versions/.gitkeep
data/hf_cache/*
!data/hf_cache/.gitkeep
data/library.json
data/settings.json
data/*.zip
*.zip

# Build artifacts & OS metadata
dist/
build/
*.spec
.DS_Store
Thumbs.db
